generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectType {
  SOFTWARE
  ANALYTICS
  NLP_ML
  DASHBOARD
  CASE_STUDY
  EXTERNAL_DEMO
}

enum ProjectStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum ProjectSectionType {
  HERO
  EXECUTIVE_SUMMARY
  PROBLEM
  DATASET
  PREPARATION
  METHODOLOGY
  KEY_METRICS
  EDA
  DEEP_DIVE
  STATISTICAL_MODEL_EVALUATION
  INSIGHTS
  RECOMMENDATIONS
  LIMITATIONS
  INTERACTIVE_DEMO
  GALLERY
  TECHNOLOGY
  SOURCE
  FINAL_TAKEAWAY
}

enum ProjectLinkType {
  OPEN_REPORT
  OPEN_LIVE_APP
  VIEW_GITHUB
  SOURCE_REPOSITORY
  EXTERNAL
  PRIMARY
  SECONDARY
}

enum ProjectMediaType {
  IMAGE
  VIDEO
  GIF
  DOCUMENT
}

enum UserRole {
  ADMIN
  EDITOR
  REVIEWER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  emailVerified DateTime?  @map("email_verified")
  image        String?
  role         UserRole    @default(VIEWER)
  status       UserStatus @default(ACTIVE)
  passwordHash String?    @map("password_hash")
  authProvider String?    @map("auth_provider")
  authSubject  String?    @map("auth_subject")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  createdProjects  Project[]         @relation("ProjectCreatedBy")
  updatedProjects  Project[]         @relation("ProjectUpdatedBy")
  projectRevisions ProjectRevision[] @relation("ProjectRevisionCreatedBy")
  auditLogs        AuditLog[]        @relation("AuditLogActor")
  publishEvents    PublishEvent[]    @relation("PublishEventActor")
  accounts         Account[]
  sessions         Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Project {
  id                String            @id @default(uuid()) @db.Uuid
  slug              String            @unique
  title             String
  projectType       ProjectType       @map("project_type")
  category          String
  shortSummary      String            @map("short_summary")
  longSummary       String            @map("long_summary")
  problemStatement  String            @map("problem_statement")
  businessObjective String            @map("business_objective")
  technologies      String[]          @default([])
  status            ProjectStatus     @default(DRAFT)
  visibility        ProjectVisibility @default(PRIVATE)
  featured          Boolean           @default(false)
  displayOrder      Int               @default(0) @map("display_order")
  canonicalRoute    String            @map("canonical_route")
  liveAppUrl        String?           @map("live_app_url")
  githubUrl         String?           @map("github_url")
  reportUrl         String?           @map("report_url")
  datasetSource     String?           @map("dataset_source")
  datasetScale      String?           @map("dataset_scale")
  metadata          Json?
  createdById       String?           @map("created_by_id") @db.Uuid
  updatedById       String?           @map("updated_by_id") @db.Uuid
  publishedAt       DateTime?         @map("published_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  createdBy     User?             @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?             @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  sections      ProjectSection[]
  metrics       ProjectMetric[]
  media         ProjectMedia[]
  links         ProjectLink[]
  revisions     ProjectRevision[]
  publishEvents PublishEvent[]
  tagMaps       ProjectTagMap[]

  @@index([projectType, status, displayOrder])
  @@index([visibility, status])
  @@map("projects")
}

model ProjectSection {
  id          String             @id @default(uuid()) @db.Uuid
  projectId   String             @map("project_id") @db.Uuid
  sectionKey  String             @map("section_key")
  sectionType ProjectSectionType @map("section_type")
  heading     String
  bodyMd      String?            @map("body_md")
  contentJson Json?              @map("content_json")
  sortOrder   Int                @map("sort_order")
  isVisible   Boolean            @default(true) @map("is_visible")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sectionKey])
  @@index([projectId, sortOrder])
  @@map("project_sections")
}

model ProjectMetric {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  label        String
  valueText    String   @map("value_text")
  valueNumeric Decimal? @map("value_numeric") @db.Decimal(18, 4)
  unit         String?
  context      String?
  sortOrder    Int      @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("project_metrics")
}

model ProjectMedia {
  id         String           @id @default(uuid()) @db.Uuid
  projectId  String           @map("project_id") @db.Uuid
  mediaType  ProjectMediaType @default(IMAGE) @map("media_type")
  storageKey String           @map("storage_key")
  publicUrl  String           @map("public_url")
  altText    String           @map("alt_text")
  caption    String
  story      String
  width      Int
  height     Int
  sortOrder  Int              @map("sort_order")
  isPublic   Boolean          @default(true) @map("is_public")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("project_media")
}

model ProjectLink {
  id        String          @id @default(uuid()) @db.Uuid
  projectId String          @map("project_id") @db.Uuid
  linkType  ProjectLinkType @map("link_type")
  label     String
  url       String
  isPrimary Boolean         @default(false) @map("is_primary")
  sortOrder Int             @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("project_links")
}

model ProjectTag {
  id   String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String

  projectMaps ProjectTagMap[]

  @@map("project_tags")
}

model ProjectTagMap {
  projectId String @map("project_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     ProjectTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@map("project_tag_map")
}

model ProjectRevision {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  revisionNumber Int      @map("revision_number")
  snapshot       Json     @map("snapshot_json")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ProjectRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([projectId, revisionNumber])
  @@index([projectId, createdAt])
  @@map("project_revisions")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  action      String
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model PublishEvent {
  id          String        @id @default(uuid()) @db.Uuid
  projectId   String        @map("project_id") @db.Uuid
  fromStatus  ProjectStatus @map("from_status")
  toStatus    ProjectStatus @map("to_status")
  note        String?
  changedById String?       @map("changed_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("PublishEventActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("publish_events")
}
