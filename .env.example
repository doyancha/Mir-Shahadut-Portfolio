# Local development default. Set a production origin before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection used by the Phase 1 database foundation.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mir_shahadut_portfolio?schema=public

# Contact form delivery via Resend. Keep these values server-only.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=no-reply@your-authorized-domain.com
CONTACT_TO_EMAIL=contact@your-domain.com

# Admin auth for the protected /admin shell.
AUTH_SECRET=
GITHUB_ID=
GITHUB_SECRET=
ADMIN_ALLOWED_GITHUB_LOGINS=
