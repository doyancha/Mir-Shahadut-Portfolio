{
  "name": "mir-shahadut-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Official professional portfolio and personal-brand website of Mir Shahadut Hossain.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "db:verify": "prisma validate",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "resume:pdf:legacy": "node -e \"console.error('resume:pdf:legacy is deprecated. The canonical resume PDF is public/documents/resume/mir-shahadut-hossain-resume.pdf. Use scripts/generate-resume-pdf.ts only with ALLOW_RESUME_PDF_OVERWRITE=1 and explicit intent.'); process.exit(1)\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "next": "^16.3.0",
    "next-auth": "^4.24.15",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
